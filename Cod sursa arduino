#include <Wire.h> 
#include <LiquidCrystal_I2C.h>
#include <DHT.h>
// Set the LCD address to 0x27 for a 16 chars and 2 line display
LiquidCrystal_I2C lcd(0x27, 16, 2);
//Constants
#define DHTPIN 7     // what pin we're connected to
#define DHTTYPE DHT11   // DHT 11
DHT dht(DHTPIN, DHTTYPE); //// Initialize DHT sensor for normal 16mhz Arduino
	
//Variables
int h;  //Stores humidity value
int t; //Stores temperature value
int buz = 11;  //buzzer connected to pin 11
const int led3=3;
const int led2=4;
const int led1=5;
const int aqsensor = A0;  //output of mq135 connected to A0 pin of Arduino
int threshold = 109;      //Threshold level for Air Quality

 void setup()
 {
        pinMode(13,OUTPUT);
        pinMode(led3,OUTPUT);
        pinMode(led2,OUTPUT);
        pinMode(led1,OUTPUT);
        pinMode(8,INPUT);
        pinMode (buz,OUTPUT);     // buzzer is connected as Output from Arduino
        pinMode (aqsensor,INPUT); // MQ135 is connected as INPUT to arduino
        Serial.begin(9600);
        Serial.println("Temperature and Humidity Sensor Test");
        dht.begin();
         // initialize the LCD
         lcd.init();
         lcd.backlight();

 } 

     void loop()
 { 
         
          if (digitalRead(8)== LOW)
        {
          digitalWrite(13,HIGH);
          delay(5); 
        }
        else 
        {
          
          digitalWrite(13,LOW);
          delay(5);
          
        }
        //Read data and store it to variables h (humidity) and t (temperature)
    // Reading temperature or humidity takes about 250 milliseconds!
    h = dht.readHumidity();
    t = dht.readTemperature();
     int ppm = analogRead(aqsensor); //read MQ135 analog outputs at A0 and store it in ppm

    Serial.print("Air Quality: ");  //print message in serail monitor
    Serial.println(ppm);            //print value of ppm in serial monitor
    //Print temp and humidity values to serial monitor
    Serial.print("Humidity: ");
    Serial.print(h);
    Serial.print(" %, Temp: ");
    Serial.print(t);
    Serial.println(" ° Celsius");
        
// set the cursor to (0,0):
// print from 0 to 9:

    lcd.setCursor(0, 0);
    lcd.println("Temp & AQ level ");
    
    lcd.setCursor(0, 1);
    lcd.print("T:");
    lcd.print(t);
    lcd.print("C");
   
    lcd.setCursor(6, 1);
    lcd.print("H:");
    lcd.print(h);
    lcd.print(" ");
    //tone(buz,1000);
    lcd.setCursor(10,1);             // set cursor of lcd to 1st row and 1st column
    lcd.print("AQ:");      // print message on lcd
    lcd.print(ppm);                 // print value of MQ135 
    

   if(ppm<180)
    {  
       digitalWrite(led3, HIGH); // Porneste LED-ul
      // tone(buz, 1000);
       delay(1000); // Așteaptă o secundă (1000 milisecunde)
        
       lcd.setCursor(0,1);         
       lcd.clear(); 
       lcd.print("Atentie pericol!");
       Serial.println("Atentie pericol!"); 
    } 
    else
    {
       digitalWrite(led3, LOW); // Oprește LED-ul
       //noTone(buz); 
       delay(1000); // Așteaptă o secundă
    }
    //delay(1000);
    if(h<55)
    {  
       digitalWrite(led2, HIGH); // Porneste LED-ul
       tone(buz, 1000);
       delay(1000); // Așteaptă o secundă (1000 milisecunde)
        
       lcd.setCursor(0,1);         
       lcd.clear(); 
       lcd.print("Atentie pericol!");
       Serial.println("Atentie pericol!"); 
    } 
    else
    {
       digitalWrite(led2, LOW); // Oprește LED-ul
       noTone(buz);
       delay(1000); // Așteaptă o secundă
    }
 // delay(1000); //Delay 1 sec.
  if(t<25)
    {  
       digitalWrite(led1, HIGH); // Porneste LED-ul
       //tone(buz, 1000);
       delay(1000); // Așteaptă o secundă (1000 milisecunde)

        
       lcd.setCursor(0,1);        
       lcd.clear(); 

       lcd.print("Atentie pericol!");
       Serial.println("Atentie pericol!"); 
    } 
    else
    {
       digitalWrite(led1, LOW); // Oprește LED-ul
       //noTone(buz);
       delay(1000); // Așteaptă o secundă
    }
 }
